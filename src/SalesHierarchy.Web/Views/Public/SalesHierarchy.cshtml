@model IEnumerable<SalesHierarchy.Core.DTOs.PublicSalesPersonDto>
@{
    ViewData["Title"] = "Sales Hierarchy";
    var people = Model.GroupBy(p => p.Id).ToDictionary(g => g.Key, g => g.First());
    var query = ViewBag.Query as string;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Sales Hierarchy</h1>
        <p class="page-subtitle">Approved names, designations, and reporting lines.</p>
    </div>
    <a asp-action="Index" class="btn btn-ghost">Directory home</a>
</div>

<div class="card-clean">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="search" name="q" value="@query" class="form-control form-control-sm" placeholder="Search people or designations..." />
            <button type="submit" class="btn btn-ghost btn-sm"><i class="bi bi-search"></i></button>
        </form>
        <span class="text-hint small">@Model.Count() person(s)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <div class="fw-semibold">No matching people</div>
                <div class="text-hint small">Try a different search term.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead><tr><th>Name</th><th>Designation</th><th>Reports to</th></tr></thead>
                    <tbody>
                    @foreach (var person in Model)
                    {
                        <tr>
                            <td class="fw-medium">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar-initials">@(string.IsNullOrWhiteSpace(person.Name) ? "?" : person.Name.Trim()[..1].ToUpperInvariant())</span>
                                    <span>@person.Name</span>
                                </div>
                            </td>
                            <td class="text-hint">@(string.IsNullOrWhiteSpace(person.Designation) ? "—" : person.Designation)</td>
                            <td class="text-hint">
                                @(person.ManagerId.HasValue && people.TryGetValue(person.ManagerId.Value, out var manager) ? manager.Name : "Top level")
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
