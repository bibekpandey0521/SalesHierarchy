@model SalesHierarchy.Core.Models.DealerMapping
@using SalesHierarchy.Core.Models
@{
    ViewData["Title"] = "Mapping details";
    var salesPerson = ViewBag.SalesPerson as SalesPerson;
    var dealer = ViewBag.Dealer as Dealer;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Mapping #@Model.UniqueID</h1>
        <p class="page-subtitle">Salesperson to dealer assignment.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-ghost">Back</a>
        <a asp-action="Edit" asp-route-id="@Model.UniqueID" class="btn btn-brand"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <dl class="detail-list mb-0">
            <dt>Salesperson</dt>
            <dd>
                @if (salesPerson != null)
                {
                    <a asp-action="Details" asp-controller="AdminSalesPerson" asp-route-id="@salesPerson.Id" class="link-subtle">@salesPerson.Name</a>
                    <span class="text-hint small">@salesPerson.Designation</span>
                }
                else
                {
                    <span class="text-hint">Unknown</span>
                }
            </dd>
            <dt>Dealer</dt>
            <dd>
                @if (dealer != null)
                {
                    <a asp-action="Details" asp-controller="AdminDealer" asp-route-id="@dealer.UniqueID" class="link-subtle">@dealer.Name</a>
                    <span class="text-hint mono small">@dealer.Code</span>
                }
                else
                {
                    <span class="text-hint">Unknown</span>
                }
            </dd>
            <dt>Mapping Id</dt>
            <dd class="mono">@Model.UniqueID</dd>
        </dl>
    </div>
</div>
