@model IEnumerable<SalesHierarchy.Core.Models.Pod>
@{
    ViewData["Title"] = "My Pods";
}
<div class="page-head">
    <div>
        <h1 class="page-title">My Pods</h1>
        <p class="page-subtitle">Points of distribution assigned to you.</p>
    </div>
</div>

<div class="card-clean">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-geo-alt"></i>
                <div class="fw-semibold">No Pods assigned</div>
                <div class="text-hint small">Your administrator has not assigned any Pods to you yet.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead><tr><th>Pod</th><th>OSS Pod Id</th><th>Station</th></tr></thead>
                    <tbody>
                    @foreach (var pod in Model)
                    {
                        <tr>
                            <td class="fw-medium">@pod.Name</td>
                            <td class="mono text-hint">@pod.OSSPODID</td>
                            <td class="mono text-hint">@(pod.PODStationId?.ToString() ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
