@model IEnumerable<SalesHierarchy.Core.Models.POD>
@{
    ViewData["Title"] = "My PODs";
}
<h2>My PODs</h2>
<table class="table">
    <thead><tr><th>Name</th><th>OSSPODID</th></tr></thead>
    <tbody>
    @foreach(var p in Model){
        <tr><td>@p.Name</td><td>@p.OSSPODID</td></tr>
    }
    </tbody>
</table>
