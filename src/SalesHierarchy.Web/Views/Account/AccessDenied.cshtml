@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access denied";
    ViewData["AuthSubtitle"] = "You don't have permission to access this resource.";
}
<div class="text-center">
    <div class="auth-confirmation-icon is-danger mx-auto">
        <i class="bi bi-shield-exclamation"></i>
    </div>
    <p class="text-muted small mb-3">If you believe this is a mistake, contact your system administrator.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-ghost w-100">
        <i class="bi bi-house"></i> Back to home
    </a>
</div>
