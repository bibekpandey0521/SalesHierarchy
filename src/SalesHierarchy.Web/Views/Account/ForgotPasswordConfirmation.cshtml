@{ Layout = "_AuthLayout"; ViewData["Title"] = "Check your email"; }
<div class="text-center">
    <div class="mb-3"><i class="bi bi-envelope-check" style="font-size: 2rem; color: var(--brand);;"></i></div>
    <h2 class="h5 fw-semibold mb-1">Check your email</h2>
    <p class="text-hint small">If an account with that email exists, we've sent a password reset link.</p>
    <a asp-action="Login" class="btn btn-ghost w-100"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
</div>