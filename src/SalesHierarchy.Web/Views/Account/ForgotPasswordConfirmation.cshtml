@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your email";
    ViewData["AuthSubtitle"] = "If an account with that email exists, we've sent a password reset link.";
}
<div class="text-center">
    <div class="auth-confirmation-icon mx-auto">
        <i class="bi bi-envelope-check"></i>
    </div>
    <p class="text-muted small mb-3">Check your inbox and follow the secure link to choose a new password.</p>
    <a asp-action="Login" class="btn btn-ghost w-100">
        <i class="bi bi-arrow-left"></i> Back to sign in
    </a>
</div>
