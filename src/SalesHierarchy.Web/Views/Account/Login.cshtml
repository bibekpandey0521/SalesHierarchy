@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    ViewData["AuthSubtitle"] = "Use your company account to continue.";
}
@model SalesHierarchy.Web.ViewModels.LoginViewModel

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@company.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="password-field">
            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
            <button class="password-toggle" type="button" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="auth-options">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
        </div>
        <a asp-action="ForgotPassword">Forgot password?</a>
    </div>

    <button type="submit" class="btn btn-auth-submit">
        <span>Sign in</span>
        <i class="bi bi-arrow-right"></i>
    </button>

    <p class="auth-support">Need an account? Contact your system administrator.</p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
