@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password reset complete";
    ViewData["AuthSubtitle"] = "Your password has been updated. You can now sign in.";
}
<div class="text-center">
    <div class="auth-confirmation-icon is-success mx-auto">
        <i class="bi bi-check-circle"></i>
    </div>
    <p class="text-muted small mb-3">Your new password is ready to use.</p>
    <a asp-action="Login" class="btn btn-brand w-100">Sign in</a>
</div>
