@{ Layout = "_AuthLayout"; ViewData["Title"] = "Password Reset Complete"; }
<div class="text-center">
    <div class="mb-3"><i class="bi bi-check-circle" style="font-size: 2rem; color: #1f7a4d;"></i></div>
    <h2 class="h5 fw-semibold mb-1">Password reset successful</h2>
    <p class="text-hint small">Your password has been updated. You can now sign in.</p>
    <a asp-action="Login" class="btn btn-brand w-100">Sign in</a>
</div>