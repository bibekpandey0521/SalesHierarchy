@{ Layout = "_AuthLayout"; ViewData["Title"] = "Reset Password"; ViewData["AuthSubtitle"] = "Choose a strong password for your account."; }
@model SalesHierarchy.Web.ViewModels.ResetPasswordViewModel
<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Token" />
    <div class="mb-3">
        <label asp-for="Email" class="form-label label-muted">Email address</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label label-muted">New password</label>
        <input asp-for="Password" class="form-control" placeholder="Enter new password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label label-muted">Confirm password</label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-brand w-100">Reset password</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}