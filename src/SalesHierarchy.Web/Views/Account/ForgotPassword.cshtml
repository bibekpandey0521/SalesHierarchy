@{ Layout = "_AuthLayout"; ViewData["Title"] = "Forgot Password"; }
@model SalesHierarchy.Web.ViewModels.ForgotPasswordViewModel
<div class="mb-3">
    <h2 class="h5 fw-semibold mb-1">Reset your password</h2>
    <p class="text-hint small mb-0">Enter your email address and we'll send you a link to reset your password.</p>
</div>
<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label label-muted">Email address</label>
        <input asp-for="Email" class="form-control" placeholder="name@company.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-brand w-100">Send reset link</button>
    <div class="text-center mt-3">
        <a asp-action="Login" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}