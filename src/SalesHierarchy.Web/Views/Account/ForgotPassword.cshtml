@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    ViewData["AuthSubtitle"] = "Enter your email address and we'll send you a reset link.";
}
@model SalesHierarchy.Web.ViewModels.ForgotPasswordViewModel

<form asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@company.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-auth-submit">
        <span>Send reset link</span>
        <i class="bi bi-arrow-right"></i>
    </button>

    <div class="auth-divider">or</div>

    <a asp-action="Login" class="btn btn-ghost w-100">
        <i class="bi bi-arrow-left"></i> Back to sign in
    </a>

    <p class="auth-support">Reset links are single-use and expire automatically.</p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
