@model SalesHierarchy.Web.ViewModels.CreateAccountViewModel
@{
    ViewData["Title"] = "Create login account";
    var managers = ViewBag.Managers as List<SalesHierarchy.Core.Models.SalesPerson> ?? new List<SalesHierarchy.Core.Models.SalesPerson>();
}
<div class="page-head">
    <div>
        <h1 class="page-title">Create login account</h1>
        <p class="page-subtitle">Creates the salesperson record, the identity account, and a secure password setup invitation.</p>
    </div>
    <a asp-action="Index" asp-controller="AdminSalesPerson" class="btn btn-ghost">Back to salespersons</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card-clean">
            <div class="card-body">
                <form asp-action="CreateAccount" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label"></label>
                            <input asp-for="Designation" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                            <div class="form-text text-hint">Used as the login name and invitation recipient.</div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ManagerId" class="form-label"></label>
                            <select asp-for="ManagerId" class="form-select">
                                <option value="">No manager (top level)</option>
                                @foreach (var manager in managers)
                                {
                                    <option value="@manager.Id">@manager.Name &mdash; @manager.Designation</option>
                                }
                            </select>
                            <span asp-validation-for="ManagerId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-brand"><i class="bi bi-send me-1"></i>Create and send invitation</button>
                        <a asp-action="Index" asp-controller="AdminSalesPerson" class="btn btn-ghost">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-clean">
            <div class="card-header">What happens next</div>
            <div class="card-body">
                <ul class="check-list mb-0">
                    <li><i class="bi bi-check2"></i>A SalesPerson record is created and linked to the account.</li>
                    <li><i class="bi bi-check2"></i>No password is chosen for the user &mdash; a unique, time-limited token is generated.</li>
                    <li><i class="bi bi-check2"></i>An invitation link is e-mailed so the user sets their own password.</li>
                    <li><i class="bi bi-check2"></i>If e-mail delivery fails, the account is still created and the invitation shows as pending.</li>
                    <li><i class="bi bi-check2"></i>Invitations can be re-sent from User Accounts.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
