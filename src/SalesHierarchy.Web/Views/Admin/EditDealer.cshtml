@model SalesHierarchy.Core.Models.Dealer
@{
    ViewData["Title"] = "Edit dealer";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Edit dealer</h1>
        <p class="page-subtitle">Update the dealer name or unique code.</p>
    </div>
    <a asp-action="Dealers" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <form asp-action="EditDealer" method="post" novalidate>
            <input type="hidden" asp-for="UniqueID" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control mono" autocomplete="off" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-brand">Save changes</button>
                <a asp-action="Dealers" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
