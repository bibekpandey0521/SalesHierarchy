@model IEnumerable<SalesHierarchy.Core.Models.AuditLog>
@{
    ViewData["Title"] = "Activity Log";
    var entities = ViewBag.Entities as string[] ?? Array.Empty<string>();
    var actions = ViewBag.Actions as string[] ?? Array.Empty<string>();
    var selectedEntity = ViewBag.Entity as string;
    var selectedAction = ViewBag.Action as string;
    var query = ViewBag.Query as string;
    var logUnavailable = ViewBag.LogUnavailable is true;

    string BadgeClass(string action) => action switch
    {
        "Create" or "AddMapping" or "Enable" or "Seed" => "badge-soft-success",
        "Delete" or "RemoveMapping" or "Disable" or "InviteResent" => "badge-soft-warning",
        "Update" or "Import" => "badge-soft-neutral",
        _ => "badge-soft-neutral"
    };
}

<div class="page-head">
    <div>
        <h1 class="page-title">Activity Log</h1>
        <p class="page-subtitle">Read-only history of changes made through the application. Passwords and invitation tokens are never recorded.</p>
    </div>
</div>

@if (logUnavailable)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        The activity log table is not available yet. Deploy <code>database/SalesHierarchy.Database/Tables/AuditLog.sql</code> to start recording history.
    </div>
}

<div class="card-clean">
    <div class="card-header">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <select name="entity" class="form-select form-select-sm" style="max-width: 190px;">
                <option value="">All entities</option>
                @foreach (var entity in entities)
                {
                    <option value="@entity" selected="@(entity == selectedEntity)">@entity</option>
                }
            </select>
            <select name="actionFilter" class="form-select form-select-sm" style="max-width: 170px;">
                <option value="">All actions</option>
                @foreach (var action in actions)
                {
                    <option value="@action" selected="@(action == selectedAction)">@action</option>
                }
            </select>
            <input type="search" name="q" value="@query" class="form-control form-control-sm" style="max-width: 260px;" placeholder="Search summary, e-mail, or Id..." />
            <button type="submit" class="btn btn-ghost btn-sm"><i class="bi bi-search me-1"></i>Filter</button>
            @if (!string.IsNullOrWhiteSpace(selectedEntity) || !string.IsNullOrWhiteSpace(selectedAction) || !string.IsNullOrWhiteSpace(query))
            {
                <a asp-action="AuditLog" class="btn btn-ghost btn-sm">Clear</a>
            }
            <span class="text-hint small ms-auto">@Model.Count() most recent event(s)</span>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-clock-history"></i>
                <div class="fw-semibold">No activity recorded</div>
                <div class="text-hint small">Changes to stations, salespersons, Pods, dealers, mappings, and accounts will appear here.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead>
                        <tr>
                            <th style="width: 160px;">When (local)</th>
                            <th style="width: 190px;">By</th>
                            <th style="width: 130px;">Action</th>
                            <th style="width: 180px;">Entity</th>
                            <th>Summary</th>
                            <th style="width: 90px;" class="text-end">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td class="text-hint small text-nowrap">@entry.OccurredUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="small">@(string.IsNullOrWhiteSpace(entry.UserEmail) ? "system" : entry.UserEmail)</td>
                            <td><span class="badge-soft @BadgeClass(entry.Action)">@entry.Action</span></td>
                            <td class="small">
                                <span class="fw-medium">@entry.EntityName</span>
                                @if (!string.IsNullOrWhiteSpace(entry.EntityId))
                                {
                                    <span class="text-hint mono">#@entry.EntityId</span>
                                }
                            </td>
                            <td class="small">@entry.Summary</td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(entry.Details))
                                {
                                    <button class="btn btn-sm btn-ghost" type="button" data-bs-toggle="collapse" data-bs-target="#audit-details-@entry.Id" aria-expanded="false" aria-controls="audit-details-@entry.Id" title="Show before/after data">
                                        <i class="bi bi-code-square"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(entry.Details))
                        {
                            <tr class="collapse" id="audit-details-@entry.Id">
                                <td colspan="6" class="bg-light">
                                    <pre class="mb-0 small text-wrap">@entry.Details</pre>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
