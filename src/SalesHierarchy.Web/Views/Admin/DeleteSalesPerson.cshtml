@model SalesHierarchy.Core.Models.SalesPerson
@{
    ViewData["Title"] = "Delete salesperson";
    var dependencies = ViewBag.Dependencies as List<string> ?? new List<string>();
    var blocked = dependencies.Count > 0;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Delete salesperson</h1>
        <p class="page-subtitle">This action cannot be undone.</p>
    </div>
    <a asp-action="SalesPersons" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <div class="alert alert-warning border-0">
            <i class="bi bi-exclamation-triangle me-1"></i>
            You are about to delete <strong>@Model.Name</strong>.
        </div>

        @if (blocked)
        {
            <div class="alert alert-danger border-0">
                <div class="fw-semibold mb-1">This record cannot be deleted yet:</div>
                <ul class="mb-0 small">
                    @foreach (var dependency in dependencies)
                    {
                        <li>@dependency</li>
                    }
                </ul>
            </div>
            <p class="text-muted small">Handle these dependencies first, then return to this page.</p>
            <a asp-action="DetailsSalesPerson" asp-route-id="@Model.ID" class="btn btn-ghost">Review record</a>
        }
        else
        {
            <p class="text-muted">No subordinates, PODs, dealer mappings, or login accounts reference this record.</p>
            <form asp-action="DeleteSalesPerson" method="post">
                <input type="hidden" name="id" value="@Model.ID" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Delete salesperson</button>
                    <a asp-action="SalesPersons" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>
