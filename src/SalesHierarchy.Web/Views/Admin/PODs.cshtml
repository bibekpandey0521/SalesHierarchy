@model IEnumerable<SalesHierarchy.Core.Models.POD>
@{
    ViewData["Title"] = "PODs";
    var stations = ViewBag.Stations as Dictionary<int, SalesHierarchy.Core.Models.PODStation> ?? new Dictionary<int, SalesHierarchy.Core.Models.PODStation>();
    var people = ViewBag.People as Dictionary<int, SalesHierarchy.Core.Models.SalesPerson> ?? new Dictionary<int, SalesHierarchy.Core.Models.SalesPerson>();
    var query = ViewBag.Query as string;
}
<div class="page-head">
    <div>
        <h1 class="page-title">PODs</h1>
        <p class="page-subtitle">Points of distribution and their salesperson assignments.</p>
    </div>
    <a asp-action="CreatePOD" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i>New POD</a>
</div>

<div class="card-clean">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="search" name="q" value="@query" class="form-control form-control-sm" placeholder="Search POD, station, or salesperson..." />
            <button type="submit" class="btn btn-ghost btn-sm"><i class="bi bi-search"></i></button>
        </form>
        <span class="text-hint small">@Model.Count() POD(s)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-geo-alt"></i>
                <div class="fw-semibold">No PODs found</div>
                <div class="text-hint small">Create a POD and assign it to a station and salesperson.</div>
                <a asp-action="CreatePOD" class="btn btn-brand btn-sm mt-2">Create POD</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead>
                        <tr><th>POD</th><th>OSS POD Id</th><th>Station</th><th>Salesperson</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var pod in Model)
                    {
                        <tr>
                            <td class="fw-medium">@pod.Name</td>
                            <td class="text-hint mono">@(string.IsNullOrWhiteSpace(pod.OSSPODID) ? "—" : pod.OSSPODID)</td>
                            <td>@(stations.TryGetValue(pod.PODStationId, out var station) ? station.Name : "—")</td>
                            <td>
                                @if (pod.salespersonId.HasValue && people.TryGetValue(pod.salespersonId.Value, out var person))
                                {
                                    <a asp-action="DetailsSalesPerson" asp-route-id="@person.ID" class="link-subtle">@person.Name</a>
                                }
                                else
                                {
                                    <span class="badge-soft-neutral">Unassigned</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="DetailsPOD" asp-route-id="@pod.ID" class="btn btn-sm btn-ghost" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="EditPOD" asp-route-id="@pod.ID" class="btn btn-sm btn-ghost" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="DeletePOD" asp-route-id="@pod.ID" class="btn btn-sm btn-ghost text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
