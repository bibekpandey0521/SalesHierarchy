@model SalesHierarchy.Core.Models.POD
@using SalesHierarchy.Core.Models
@{
    ViewData["Title"] = "POD details";
    var station = ViewBag.Station as PODStation;
    var salesPerson = ViewBag.SalesPerson as SalesPerson;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">POD details and current assignment.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PODs" class="btn btn-ghost">Back</a>
        <a asp-action="EditPOD" asp-route-id="@Model.ID" class="btn btn-brand"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <dl class="detail-list mb-0">
            <dt>POD name</dt>
            <dd>@Model.Name</dd>
            <dt>OSS POD Id</dt>
            <dd class="mono">@(string.IsNullOrWhiteSpace(Model.OSSPODID) ? "—" : Model.OSSPODID)</dd>
            <dt>POD station</dt>
            <dd>
                @if (station != null)
                {
                    <a asp-action="DetailsPODStation" asp-route-id="@station.ID" class="link-subtle">@station.Name</a>
                }
                else
                {
                    <span class="text-hint">Not available</span>
                }
            </dd>
            <dt>Assigned salesperson</dt>
            <dd>
                @if (salesPerson != null)
                {
                    <a asp-action="DetailsSalesPerson" asp-route-id="@salesPerson.ID" class="link-subtle">@salesPerson.Name</a>
                    <span class="text-hint small">@salesPerson.Designation</span>
                }
                else
                {
                    <span class="badge-soft-neutral">Unassigned</span>
                }
            </dd>
        </dl>
    </div>
</div>
