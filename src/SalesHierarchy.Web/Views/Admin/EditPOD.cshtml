@model SalesHierarchy.Core.Models.POD
@{
    ViewData["Title"] = "Edit POD";
    var stations = ViewBag.PODStations as List<SalesHierarchy.Core.Models.PODStation> ?? new List<SalesHierarchy.Core.Models.PODStation>();
    var salesPersons = ViewBag.SalesPersons as List<SalesHierarchy.Core.Models.SalesPerson> ?? new List<SalesHierarchy.Core.Models.SalesPerson>();
}
<div class="page-head">
    <div>
        <h1 class="page-title">Edit POD</h1>
        <p class="page-subtitle">Update POD information and assignments.</p>
    </div>
    <a asp-action="PODs" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <form asp-action="EditPOD" method="post" novalidate>
            <input type="hidden" asp-for="ID" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OSSPODID" class="form-label"></label>
                    <input asp-for="OSSPODID" class="form-control mono" autocomplete="off" />
                    <span asp-validation-for="OSSPODID" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PODStationId" class="form-label"></label>
                    <select asp-for="PODStationId" class="form-select">
                        <option value="">Select a station</option>
                        @foreach (var station in stations)
                        {
                            <option value="@station.ID">@station.Name</option>
                        }
                    </select>
                    <span asp-validation-for="PODStationId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="salespersonId" class="form-label"></label>
                    <select asp-for="salespersonId" class="form-select">
                        <option value="">Leave unassigned</option>
                        @foreach (var person in salesPersons)
                        {
                            <option value="@person.ID">@person.Name — @person.Designation</option>
                        }
                    </select>
                    <span asp-validation-for="salespersonId" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-brand">Save changes</button>
                <a asp-action="PODs" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
