@model SalesHierarchy.Core.Models.PODStation
@{
    ViewData["Title"] = "Station details";
    var pods = ViewBag.Pods as List<SalesHierarchy.Core.Models.POD> ?? new List<SalesHierarchy.Core.Models.POD>();
}
<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">POD station details and assigned PODs.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PODStations" class="btn btn-ghost">Back</a>
        <a asp-action="EditPODStation" asp-route-id="@Model.ID" class="btn btn-brand"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-clean">
            <div class="card-header">Station information</div>
            <div class="card-body">
                <dl class="detail-list mb-0">
                    <dt>Name</dt>
                    <dd>@Model.Name</dd>
                    <dt>OSS POD Station Id</dt>
                    <dd class="mono">@(string.IsNullOrWhiteSpace(Model.OSSPODStationId) ? "—" : Model.OSSPODStationId)</dd>
                    <dt>Database Id</dt>
                    <dd class="mono">@Model.ID</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card-clean">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>PODs assigned to this station</span>
                <span class="badge-soft-neutral">@pods.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pods.Count == 0)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-geo-alt"></i>
                        <div class="text-hint small">No PODs are assigned to this station.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-clean mb-0">
                            <thead><tr><th>POD</th><th>OSS POD Id</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var pod in pods)
                            {
                                <tr>
                                    <td class="fw-medium">@pod.Name</td>
                                    <td class="text-hint mono">@(string.IsNullOrWhiteSpace(pod.OSSPODID) ? "—" : pod.OSSPODID)</td>
                                    <td class="text-end"><a asp-action="DetailsPOD" asp-route-id="@pod.ID" class="btn btn-sm btn-ghost">View</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
