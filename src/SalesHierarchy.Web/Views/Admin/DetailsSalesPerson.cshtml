@model SalesHierarchy.Core.Models.SalesPerson
@using SalesHierarchy.Core.Models
@{
    ViewData["Title"] = "Salesperson details";
    var manager = ViewBag.Manager as SalesPerson;
    var directReports = ViewBag.DirectReports as List<SalesPerson> ?? new List<SalesPerson>();
    var allReports = ViewBag.AllReports as IReadOnlyList<SalesPerson> ?? new List<SalesPerson>();
    var managerChain = ViewBag.ManagerChain as IReadOnlyList<SalesPerson> ?? new List<SalesPerson>();
    var pods = ViewBag.Pods as List<POD> ?? new List<POD>();
    var mappings = ViewBag.Mappings as List<SalesDealerMapping> ?? new List<SalesDealerMapping>();
    var dealers = ViewBag.Dealers as Dictionary<int, Dealer> ?? new Dictionary<int, Dealer>();
    var account = ViewBag.Account as SalesHierarchy.Web.Data.ApplicationUser;
}
<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">@(string.IsNullOrWhiteSpace(Model.Designation) ? "No designation" : Model.Designation)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SalesPersons" class="btn btn-ghost">Back</a>
        @if (account != null)
        {
            <a asp-action="UserAccountManagement" class="btn btn-ghost"><i class="bi bi-shield-lock me-1"></i>Manage account</a>
        }
        else
        {
            <a asp-action="CreateSalesPersonAccount" class="btn btn-ghost"><i class="bi bi-person-plus me-1"></i>Create account</a>
        }
        <a asp-action="EditSalesPerson" asp-route-id="@Model.ID" class="btn btn-brand"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-clean mb-3">
            <div class="card-header">Profile</div>
            <div class="card-body">
                <dl class="detail-list mb-0">
                    <dt>Name</dt>
                    <dd>@Model.Name</dd>
                    <dt>Designation</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Designation) ? "—" : Model.Designation)</dd>
                    <dt>Reports to</dt>
                    <dd>
                        @if (manager != null)
                        {
                            <a asp-action="DetailsSalesPerson" asp-route-id="@manager.ID" class="link-subtle">@manager.Name</a>
                        }
                        else
                        {
                            <span class="text-hint">Top level</span>
                        }
                    </dd>
                    <dt>Login account</dt>
                    <dd>
                        @if (account != null)
                        {
                            <span class="badge-soft-success">@account.Email</span>
                        }
                        else
                        {
                            <span class="badge-soft-neutral">Not created</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card-clean mb-3">
            <div class="card-header">Reporting chain</div>
            <div class="card-body">
                @if (managerChain.Count == 0)
                {
                    <p class="text-hint small mb-0">This person is at the top of the hierarchy.</p>
                }
                else
                {
                    <ol class="chain-list mb-0">
                        @foreach (var chainManager in managerChain)
                        {
                            <li>
                                <a asp-action="DetailsSalesPerson" asp-route-id="@chainManager.ID" class="link-subtle">@chainManager.Name</a>
                                <span class="text-hint small">@chainManager.Designation</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>

        <div class="card-clean">
            <div class="card-header">Assigned PODs</div>
            <div class="card-body">
                @if (pods.Count == 0)
                {
                    <p class="text-hint small mb-0">No PODs assigned.</p>
                }
                else
                {
                    <ul class="list-plain mb-0">
                        @foreach (var pod in pods)
                        {
                            <li><span>@pod.Name</span><span class="text-hint mono small">@pod.OSSPODID</span></li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-clean mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Direct reports</span>
                <span class="badge-soft-neutral">@directReports.Count</span>
            </div>
            <div class="card-body p-0">
                @if (directReports.Count == 0)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-person-check"></i>
                        <div class="text-hint small">No direct reports.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-clean mb-0">
                            <thead><tr><th>Name</th><th>Designation</th><th class="text-end"></th></tr></thead>
                            <tbody>
                            @foreach (var report in directReports)
                            {
                                <tr>
                                    <td class="fw-medium">@report.Name</td>
                                    <td class="text-hint">@(string.IsNullOrWhiteSpace(report.Designation) ? "—" : report.Designation)</td>
                                    <td class="text-end"><a asp-action="DetailsSalesPerson" asp-route-id="@report.ID" class="btn btn-sm btn-ghost">View</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card-clean mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Full reporting hierarchy</span>
                <span class="badge-soft-neutral">@allReports.Count indirect + direct</span>
            </div>
            <div class="card-body">
                @if (allReports.Count == 0)
                {
                    <p class="text-hint small mb-0">No indirect reports.</p>
                }
                else
                {
                    <ul class="list-plain mb-0">
                        @foreach (var report in allReports)
                        {
                            <li>
                                <a asp-action="DetailsSalesPerson" asp-route-id="@report.ID" class="link-subtle">@report.Name</a>
                                <span class="text-hint small">@report.Designation</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card-clean">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Dealer mappings</span>
                <span class="badge-soft-neutral">@mappings.Count</span>
            </div>
            <div class="card-body p-0">
                @if (mappings.Count == 0)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-shop"></i>
                        <div class="text-hint small">No dealers mapped to this salesperson.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-clean mb-0">
                            <thead><tr><th>Dealer</th><th>Code</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var mapping in mappings)
                            {
                                <tr>
                                    <td class="fw-medium">@(dealers.TryGetValue(mapping.dealerid, out var dealer) ? dealer.Name : mapping.dealerid.ToString())</td>
                                    <td class="text-hint mono">@(dealers.TryGetValue(mapping.dealerid, out var dealerCode) ? dealerCode.Code : "—")</td>
                                    <td class="text-end"><a asp-action="DetailsSalesDealerMapping" asp-route-id="@mapping.UniqueID" class="btn btn-sm btn-ghost">View</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
