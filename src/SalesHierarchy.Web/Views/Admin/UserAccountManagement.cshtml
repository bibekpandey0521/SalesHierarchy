@model System.Collections.Generic.List<SalesHierarchy.Web.Data.ApplicationUser>
@using SalesHierarchy.Web.Data
@{
    ViewData["Title"] = "User Account Management";
}
<h2>User Account Management</h2>
@if(TempData["Message"] != null){ <div>@TempData["Message"]</div> }
<table class="table">
    <thead><tr><th>Email</th><th>UserName</th><th>EmailConfirmed</th><th></th></tr></thead>
    <tbody>
    @foreach(var u in Model){
        <tr>
            <td>@u.Email</td>
            <td>@u.UserName</td>
            <td>@u.EmailConfirmed</td>
            <td>
                <form asp-action="ResendInvitation" method="post" style="display:inline">
                    <input type="hidden" name="userId" value="@u.Id" />
                    <button type="submit" class="btn btn-sm btn-secondary">Resend Invitation</button>
                </form>
                <form asp-action="DisableAccount" method="post" style="display:inline">
                    <input type="hidden" name="userId" value="@u.Id" />
                    <button type="submit" class="btn btn-sm btn-danger">Disable</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
