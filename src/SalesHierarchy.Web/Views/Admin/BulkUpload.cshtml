@{
    ViewData["Title"] = "Bulk Upload";
}
<h2>Bulk Upload (Excel)</h2>
<p><a asp-action="DownloadTemplate">Download Template</a></p>
<form asp-action="BulkUpload" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <input type="file" name="file" accept=".xlsx" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>
@if(TempData["Message"] != null){ <div>@TempData["Message"]</div> }
<p>Template columns: Name, Designation, Email, ManagerEmail (ManagerEmail blank for top-level).</p>
