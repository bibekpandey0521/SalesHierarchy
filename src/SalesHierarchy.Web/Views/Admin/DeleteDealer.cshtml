@model SalesHierarchy.Core.Models.Dealer
@{
    ViewData["Title"] = "Delete dealer";
    var mappingCount = ViewBag.MappingCount as int? ?? 0;
    var blocked = mappingCount > 0;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Delete dealer</h1>
        <p class="page-subtitle">This action cannot be undone.</p>
    </div>
    <a asp-action="Dealers" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <div class="alert alert-warning border-0">
            <i class="bi bi-exclamation-triangle me-1"></i>
            You are about to delete <strong>@Model.Name</strong> (@Model.Code).
        </div>

        @if (blocked)
        {
            <div class="alert alert-danger border-0">
                This dealer cannot be deleted while @mappingCount dealer mapping(s) still reference it. Remove those mappings first.
            </div>
            <a asp-action="SalesDealerMappings" class="btn btn-ghost">Open mappings</a>
        }
        else
        {
            <p class="text-muted">No dealer mappings reference this dealer, so it is safe to delete.</p>
            <form asp-action="DeleteDealer" method="post">
                <input type="hidden" name="id" value="@Model.UniqueID" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Delete dealer</button>
                    <a asp-action="Dealers" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>
