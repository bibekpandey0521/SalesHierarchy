@model IEnumerable<SalesHierarchy.Core.Models.SalesPerson>
@{
    ViewData["Title"] = "Sales Persons";
    var people = ViewBag.People as Dictionary<int, SalesHierarchy.Core.Models.SalesPerson> ?? new Dictionary<int, SalesHierarchy.Core.Models.SalesPerson>();
    var query = ViewBag.Query as string;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Sales Persons</h1>
        <p class="page-subtitle">Business records and reporting lines. Login accounts are managed separately.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="CreateSalesPersonAccount" class="btn btn-brand"><i class="bi bi-person-plus me-1"></i>Create login account</a>
        <a asp-action="CreateSalesPerson" class="btn btn-ghost"><i class="bi bi-plus-lg me-1"></i>New record</a>
    </div>
</div>

<div class="card-clean">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="search" name="q" value="@query" class="form-control form-control-sm" placeholder="Search name or designation..." />
            <button type="submit" class="btn btn-ghost btn-sm"><i class="bi bi-search"></i></button>
        </form>
        <div class="d-flex gap-2">
            <a asp-action="BulkUpload" class="btn btn-ghost btn-sm"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Bulk upload</a>
            <span class="text-hint small align-self-center">@Model.Count() record(s)</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <div class="fw-semibold">No salespersons yet</div>
                <div class="text-hint small">Create a record individually or upload an Excel file.</div>
                <a asp-action="CreateSalesPerson" class="btn btn-brand btn-sm mt-2">Create salesperson</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead>
                        <tr><th>Name</th><th>Designation</th><th>Reports to</th><th>Direct reports</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var person in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar-initials">@(string.IsNullOrWhiteSpace(person.Name) ? "?" : person.Name.Trim()[..1].ToUpperInvariant())</span>
                                    <span class="fw-medium">@person.Name</span>
                                </div>
                            </td>
                            <td class="text-hint">@(string.IsNullOrWhiteSpace(person.Designation) ? "—" : person.Designation)</td>
                            <td>
                                @if (person.ManagerId.HasValue && people.TryGetValue(person.ManagerId.Value, out var manager))
                                {
                                    <a asp-action="DetailsSalesPerson" asp-route-id="@manager.ID" class="link-subtle">@manager.Name</a>
                                }
                                else
                                {
                                    <span class="text-hint">Top level</span>
                                }
                            </td>
                            <td class="text-hint">@people.Values.Count(p => p.ManagerId == person.ID)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="DetailsSalesPerson" asp-route-id="@person.ID" class="btn btn-sm btn-ghost" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="EditSalesPerson" asp-route-id="@person.ID" class="btn btn-sm btn-ghost" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="DeleteSalesPerson" asp-route-id="@person.ID" class="btn btn-sm btn-ghost text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
