@model SalesHierarchy.Core.Models.SalesPerson
@{
    ViewData["Title"] = "Edit salesperson";
    var managers = ViewBag.Managers as List<SalesHierarchy.Core.Models.SalesPerson> ?? new List<SalesHierarchy.Core.Models.SalesPerson>();
}
<div class="page-head">
    <div>
        <h1 class="page-title">Edit salesperson</h1>
        <p class="page-subtitle">Update details or change the reporting manager.</p>
    </div>
    <a asp-action="SalesPersons" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <form asp-action="EditSalesPerson" method="post" novalidate>
            <input type="hidden" asp-for="ID" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Designation" class="form-label"></label>
                    <input asp-for="Designation" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Designation" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ManagerId" class="form-label"></label>
                    <select asp-for="ManagerId" class="form-select">
                        <option value="">No manager (top level)</option>
                        @foreach (var manager in managers)
                        {
                            <option value="@manager.ID">@manager.Name — @manager.Designation</option>
                        }
                    </select>
                    <div class="form-text text-hint">Self-reporting and circular relationships are rejected.</div>
                    <span asp-validation-for="ManagerId" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-brand">Save changes</button>
                <a asp-action="SalesPersons" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
