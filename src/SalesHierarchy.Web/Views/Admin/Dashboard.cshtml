@{
    ViewData["Title"] = "Organization overview";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<partial name="_DashboardBanner" />

<div class="page-head">
    <div>
        <h1 class="page-title">Organization overview</h1>
        <p class="page-subtitle">Master data, hierarchy, account activity, and day-to-day administration.</p>
    </div>
    <div class="page-actions">
        <a asp-action="BulkUpload" class="btn btn-ghost"><i class="bi bi-file-earmark-spreadsheet"></i>Bulk upload</a>
        <a asp-action="CreateAccount" class="btn btn-brand"><i class="bi bi-person-plus"></i>Create account</a>
    </div>
</div>

<div class="metric-grid">
    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-label">Pod stations</span>
            <span class="metric-icon"><i class="bi bi-building"></i></span>
        </div>
        <div class="metric-value">@ViewBag.PodStationCount</div>
        <div class="metric-meta">
            <span class="metric-delta is-neutral">Live</span>
            <span class="metric-hint">station locations</span>
        </div>
    </article>
    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-label">Pods</span>
            <span class="metric-icon"><i class="bi bi-geo-alt"></i></span>
        </div>
        <div class="metric-value">@ViewBag.PodCount</div>
        <div class="metric-meta">
            <span class="metric-delta is-neutral">Live</span>
            <span class="metric-hint">points of distribution</span>
        </div>
    </article>
    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-label">Salespersons</span>
            <span class="metric-icon"><i class="bi bi-people"></i></span>
        </div>
        <div class="metric-value">@ViewBag.SalesPersonCount</div>
        <div class="metric-meta">
            <span class="metric-delta is-neutral">Live</span>
            <span class="metric-hint">directory records</span>
        </div>
    </article>
    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-label">Dealers</span>
            <span class="metric-icon"><i class="bi bi-shop"></i></span>
        </div>
        <div class="metric-value">@ViewBag.DealerCount</div>
        <div class="metric-meta">
            <span class="metric-delta is-neutral">@ViewBag.MappingCount mapped</span>
            <span class="metric-hint">active dealer records</span>
        </div>
    </article>
</div>

<div class="dashboard-grid">
    <section class="dashboard-card">
        <div class="dashboard-card-head">
            <div>
                <h2 class="dashboard-card-title">Quick actions</h2>
                <p class="dashboard-card-subtitle">Common day-to-day administration tasks</p>
            </div>
        </div>
        <div class="dashboard-card-body">
            <div class="quick-grid">
                <a asp-action="Index" asp-controller="AdminSalesPerson" class="quick-link">
                    <i class="bi bi-people"></i>
                    <div>
                        <div class="fw-semibold">Employee directory</div>
                        <div class="text-hint">Hierarchy and reporting lines</div>
                    </div>
                </a>
                <a asp-action="Index" asp-controller="AdminPodStation" class="quick-link">
                    <i class="bi bi-building"></i>
                    <div>
                        <div class="fw-semibold">Pod stations</div>
                        <div class="text-hint">Locations and OSS identifiers</div>
                    </div>
                </a>
                <a asp-action="Index" asp-controller="AdminPod" class="quick-link">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <div class="fw-semibold">Pods</div>
                        <div class="text-hint">Assign stations and salespeople</div>
                    </div>
                </a>
                <a asp-action="Index" asp-controller="AdminDealerMapping" class="quick-link">
                    <i class="bi bi-diagram-2"></i>
                    <div>
                        <div class="fw-semibold">Dealer mappings</div>
                        <div class="text-hint">@ViewBag.MappingCount assignment(s)</div>
                    </div>
                </a>
                <a asp-action="UserAccountManagement" class="quick-link">
                    <i class="bi bi-shield-lock"></i>
                    <div>
                        <div class="fw-semibold">User accounts</div>
                        <div class="text-hint">@ViewBag.UserCount account(s)</div>
                    </div>
                </a>
                <a asp-action="BulkUpload" class="quick-link">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    <div>
                        <div class="fw-semibold">Bulk upload</div>
                        <div class="text-hint">Create records from Excel</div>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <section class="dashboard-card">
        <div class="dashboard-card-head">
            <div>
                <h2 class="dashboard-card-title">Security checklist</h2>
                <p class="dashboard-card-subtitle">Guardrails enforced by the application</p>
            </div>
        </div>
        <div class="dashboard-card-body">
            <ul class="check-list mb-0">
                <li><i class="bi bi-check2"></i>Only System Administrators can create login accounts.</li>
                <li><i class="bi bi-check2"></i>Password setup links are single-use and time-limited.</li>
                <li><i class="bi bi-check2"></i>Failed invitations are reported, never silently ignored.</li>
                <li><i class="bi bi-check2"></i>Deletes are blocked while dependencies exist.</li>
                <li><i class="bi bi-check2"></i>Public pages never show emails or dealer mappings.</li>
            </ul>
        </div>
    </section>
</div>
