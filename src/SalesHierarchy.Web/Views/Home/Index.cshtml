@{
    ViewData["Title"] = "Home";
}
<section class="hero-card">
    <div class="hero-copy">
        <span class="badge-soft-neutral mb-2 d-inline-block">Enterprise sales operations</span>
        <h1 class="hero-title">A single source of truth for your sales hierarchy</h1>
        <p class="hero-subtitle">Manage salespersons, POD stations, dealers, and reporting lines with role-based access and secure account invitations.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-brand" asp-controller="Public" asp-action="Index"><i class="bi bi-globe2 me-1"></i>Browse public directory</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-ghost" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</a>
            }
            else if (User.IsInRole("SystemAdmin"))
            {
                <a class="btn btn-ghost" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Admin dashboard</a>
            }
            else
            {
                <a class="btn btn-ghost" asp-controller="SalesPerson" asp-action="Dashboard"><i class="bi bi-grid me-1"></i>My workspace</a>
            }
        </div>
    </div>
    <div class="hero-panel">
        <div class="hero-panel-row">
            <i class="bi bi-people"></i>
            <div>
                <div class="fw-semibold">Reporting hierarchy</div>
                <div class="text-hint small">ManagerId-driven, cycle-safe, team-scoped.</div>
            </div>
        </div>
        <div class="hero-panel-row">
            <i class="bi bi-shield-check"></i>
            <div>
                <div class="fw-semibold">Identity-based access</div>
                <div class="text-hint small">System Admin and SalesPerson roles only.</div>
            </div>
        </div>
        <div class="hero-panel-row">
            <i class="bi bi-envelope-check"></i>
            <div>
                <div class="fw-semibold">Secure invitations</div>
                <div class="text-hint small">No shared passwords. Time-limited setup links.</div>
            </div>
        </div>
    </div>
</section>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="card-clean h-100">
            <div class="card-body">
                <i class="bi bi-diagram-3 feature-icon"></i>
                <div class="fw-semibold mt-3">Hierarchy without guesswork</div>
                <p class="text-muted small mb-0">Reporting lines are stored on the record, not inferred from job titles. Circular and self-reporting changes are rejected.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-clean h-100">
            <div class="card-body">
                <i class="bi bi-shop feature-icon"></i>
                <div class="fw-semibold mt-3">Assignments that stay consistent</div>
                <p class="text-muted small mb-0">PODs and dealers are linked through validated foreign keys with duplicate mapping protection and guarded deletes.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-clean h-100">
            <div class="card-body">
                <i class="bi bi-file-earmark-spreadsheet feature-icon"></i>
                <div class="fw-semibold mt-3">Bulk onboarding with control</div>
                <p class="text-muted small mb-0">Validate every Excel row, preview the outcome, then confirm. Failed rows produce a downloadable report.</p>
            </div>
        </div>
    </div>
</div>
