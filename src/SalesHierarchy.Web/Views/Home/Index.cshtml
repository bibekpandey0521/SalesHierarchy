@{
    ViewData["Title"] = "Home";
}
<div class="row g-4">
    <div class="col-12">
        <div class="card-clean">
            <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div>
                    <h1 class="h4 fw-semibold mb-1">SalesHierarchy</h1>
                    <p class="text-hint mb-0">A clean, enterprise-grade view of your sales organization, reporting structure, and assignments.</p>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-brand" asp-controller="Public" asp-action="Index"><i class="bi bi-globe2 me-1"></i>Public Directory</a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="btn btn-ghost" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>