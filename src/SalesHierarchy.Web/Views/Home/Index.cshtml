@model SalesHierarchy.Web.ViewModels.HomeViewModel
@using SalesHierarchy.Core.Models
@{
    ViewData["Title"] = Model.IsAuthenticated ? "Organization overview" : "SalesHierarchy";
    var growthMax = Model.Growth.Count == 0 ? 0 : Model.Growth.Max(g => g.Value);
    var activityController = Model.IsAdmin ? "Admin" : "SalesPerson";
    var activityAction = Model.IsAdmin ? "AuditLog" : "TeamActivity";
    var podController = Model.IsAdmin ? "Admin" : "SalesPerson";
    var podAction = Model.IsAdmin ? "PODs" : "MyPODs";
    var addEmployeeController = Model.IsAdmin ? "Admin" : "SalesPerson";
    var addEmployeeAction = Model.IsAdmin ? "CreateSalesPerson" : "CreateTeamMember";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hierarchy.css" asp-append-version="true" />
}

@if (!Model.IsAuthenticated)
{
    <div class="public-page">
        <section class="hero-card">
            <div class="hero-copy">
                <span class="badge-soft-neutral mb-2 d-inline-block">Enterprise sales operations</span>
                <h1 class="hero-title">A single source of truth for your sales hierarchy</h1>
                <p class="hero-subtitle">Manage salespeople, POD stations, dealers, and reporting lines with role-based access and secure account invitations.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-brand" asp-controller="Public" asp-action="Index"><i class="bi bi-globe2"></i>Browse public directory</a>
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i>Sign in</a>
                </div>
            </div>
            <div class="hero-panel">
                <div class="hero-panel-row">
                    <i class="bi bi-diagram-3"></i>
                    <div>
                        <div class="fw-semibold">Reporting hierarchy</div>
                        <div class="text-hint small">Manager-driven, cycle-safe, and team-scoped.</div>
                    </div>
                </div>
                <div class="hero-panel-row">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <div class="fw-semibold">Identity-based access</div>
                        <div class="text-hint small">System Admin and SalesPerson roles only.</div>
                    </div>
                </div>
                <div class="hero-panel-row">
                    <i class="bi bi-envelope-check"></i>
                    <div>
                        <div class="fw-semibold">Secure invitations</div>
                        <div class="text-hint small">No shared passwords. Time-limited setup links.</div>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <div class="card-clean h-100">
                    <div class="card-body">
                        <i class="bi bi-diagram-3 feature-icon"></i>
                        <div class="fw-semibold mt-3">Hierarchy without guesswork</div>
                        <p class="text-muted small mb-0">Reporting lines are stored on the record, not inferred from titles. Circular and self-reporting changes are rejected.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-clean h-100">
                    <div class="card-body">
                        <i class="bi bi-shop feature-icon"></i>
                        <div class="fw-semibold mt-3">Assignments that stay consistent</div>
                        <p class="text-muted small mb-0">PODs and dealers are linked through validated relationships with duplicate protection and guarded deletes.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-clean h-100">
                    <div class="card-body">
                        <i class="bi bi-file-earmark-spreadsheet feature-icon"></i>
                        <div class="fw-semibold mt-3">Bulk onboarding with control</div>
                        <p class="text-muted small mb-0">Validate every Excel row, preview the outcome, then confirm. Failed rows produce a downloadable report.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="page-head">
        <div>
            <h1 class="page-title">Organization overview</h1>
            <p class="page-subtitle">Welcome back, @Model.DisplayName. Here is the latest view of your people, POD coverage, and reporting lines.</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-ghost" data-export-table="#podCoverageTable" data-export-name="saleshierarchy-overview">
                <i class="bi bi-download"></i>Export report
            </button>
            <a class="btn btn-brand" asp-controller="@addEmployeeController" asp-action="@addEmployeeAction">
                <i class="bi bi-plus-lg"></i>Add employee
            </a>
        </div>
    </div>

    <div class="metric-grid">
        <article class="metric-card">
            <div class="metric-card-top">
                <span class="metric-label">Total employees</span>
                <span class="metric-icon"><i class="bi bi-people"></i></span>
            </div>
            <div class="metric-value">@Model.EmployeeCount</div>
            <div class="metric-meta">
                @if (Model.NewEmployeeCount > 0)
                {
                    <span class="metric-delta"><i class="bi bi-arrow-up-short"></i>@Model.NewEmployeeCount</span>
                    <span class="metric-hint">new in last 30 days</span>
                }
                else
                {
                    <span class="metric-delta is-neutral">Live</span>
                    <span class="metric-hint">directory records</span>
                }
            </div>
            <div class="metric-sparkline" aria-hidden="true">
                <svg viewBox="0 0 120 34" preserveAspectRatio="none">
                    <path class="spark-area" d="M0 29 L10 26 L20 27 L30 22 L40 24 L50 18 L60 20 L70 14 L80 16 L90 10 L100 12 L110 7 L120 8 L120 34 L0 34 Z"></path>
                    <path class="spark-line" d="M0 29 L10 26 L20 27 L30 22 L40 24 L50 18 L60 20 L70 14 L80 16 L90 10 L100 12 L110 7 L120 8"></path>
                </svg>
            </div>
        </article>

        <article class="metric-card">
            <div class="metric-card-top">
                <span class="metric-label">POD stations</span>
                <span class="metric-icon"><i class="bi bi-building"></i></span>
            </div>
            <div class="metric-value">@Model.StationCount</div>
            <div class="metric-meta">
                <span class="metric-delta is-neutral">Live</span>
                <span class="metric-hint">station locations</span>
            </div>
            <div class="metric-sparkline" aria-hidden="true">
                <svg viewBox="0 0 120 34" preserveAspectRatio="none">
                    <path class="spark-area" d="M0 25 L12 25 L24 21 L36 22 L48 18 L60 19 L72 15 L84 16 L96 12 L108 13 L120 9 L120 34 L0 34 Z"></path>
                    <path class="spark-line" d="M0 25 L12 25 L24 21 L36 22 L48 18 L60 19 L72 15 L84 16 L96 12 L108 13 L120 9"></path>
                </svg>
            </div>
        </article>

        <article class="metric-card">
            <div class="metric-card-top">
                <span class="metric-label">Assigned PODs</span>
                <span class="metric-icon"><i class="bi bi-geo-alt"></i></span>
            </div>
            <div class="metric-value">@Model.AssignedPods</div>
            <div class="metric-meta">
                <span class="metric-delta is-neutral">@Model.PodCount total</span>
                <span class="metric-hint">points of distribution</span>
            </div>
            <div class="metric-sparkline" aria-hidden="true">
                <svg viewBox="0 0 120 34" preserveAspectRatio="none">
                    <path class="spark-area" d="M0 30 L12 27 L24 28 L36 23 L48 24 L60 20 L72 17 L84 18 L96 13 L108 14 L120 10 L120 34 L0 34 Z"></path>
                    <path class="spark-line" d="M0 30 L12 27 L24 28 L36 23 L48 24 L60 20 L72 17 L84 18 L96 13 L108 14 L120 10"></path>
                </svg>
            </div>
        </article>

        <article class="metric-card">
            <div class="metric-card-top">
                <span class="metric-label">Hierarchy levels</span>
                <span class="metric-icon"><i class="bi bi-diagram-3"></i></span>
            </div>
            <div class="metric-value">@Model.Levels</div>
            <div class="metric-meta">
                <span class="metric-delta is-neutral">Live</span>
                <span class="metric-hint">reporting depth</span>
            </div>
            <div class="metric-sparkline" aria-hidden="true">
                <svg viewBox="0 0 120 34" preserveAspectRatio="none">
                    <path class="spark-area" d="M0 27 L12 24 L24 25 L36 21 L48 22 L60 18 L72 17 L84 13 L96 14 L108 10 L120 11 L120 34 L0 34 Z"></path>
                    <path class="spark-line" d="M0 27 L12 24 L24 25 L36 21 L48 22 L60 18 L72 17 L84 13 L96 14 L108 10 L120 11"></path>
                </svg>
            </div>
        </article>
    </div>

    <div class="dashboard-grid">
        <section class="dashboard-card">
            <div class="dashboard-card-head">
                <div>
                    <h2 class="dashboard-card-title">Team growth</h2>
                    <p class="dashboard-card-subtitle">Salesperson records added over time</p>
                </div>
                @if (growthMax > 0)
                {
                    <div class="segmented" aria-label="Growth period">
                        <button type="button" class="active" aria-pressed="true" data-month-window="6">6M</button>
                        <button type="button" aria-pressed="false" data-month-window="12">12M</button>
                    </div>
                }
            </div>
            <div class="dashboard-card-body">
                @if (growthMax == 0)
                {
                    <div class="growth-empty">
                        <i class="bi bi-bar-chart-line"></i>
                        <div>Growth history appears here as salesperson records are added.</div>
                    </div>
                }
                else
                {
                    <div class="growth-chart">
                        @for (var i = 0; i < Model.Growth.Count; i++)
                        {
                            var point = Model.Growth[i];
                            var height = Math.Max(3, (int)Math.Round(point.Value * 100.0 / growthMax));
                            var hidden = i < Model.Growth.Count - 6;
                            <div class="growth-column" data-month-index="@i" data-hidden="@(hidden ? "true" : "false")">
                                <span class="growth-value">@point.Value</span>
                                <div class="growth-bar-track">
                                    <div class="growth-bar" style="height: @(height)%;"></div>
                                </div>
                                <span class="growth-label">@point.Label</span>
                            </div>
                        }
                    </div>
                    <div class="growth-legend">
                        <span><span class="legend-dot is-brand"></span>New records</span>
                        <span class="text-hint">Peak: @growthMax in a month</span>
                    </div>
                }
            </div>
        </section>

        <section class="dashboard-card">
            <div class="dashboard-card-head">
                <div>
                    <h2 class="dashboard-card-title">Recent activity</h2>
                    <p class="dashboard-card-subtitle">Latest changes in your workspace</p>
                </div>
                <a class="link-subtle" style="font-size: 11px;" asp-controller="@activityController" asp-action="@activityAction">View all</a>
            </div>
            <div class="dashboard-card-body">
                @if (Model.Activity.Count == 0)
                {
                    <div class="activity-empty">No activity has been recorded yet.</div>
                }
                else
                {
                    <ol class="activity-list">
                        @foreach (var log in Model.Activity)
                        {
                            var accent = log.Action is "Create" or "Import" or "PasswordSet" or "AssignPOD";
                            var success = log.Action is "Delete" or "Disable";
                            <li class="activity-item @(accent ? "is-accent" : "") @(success ? "is-success" : "")">
                                <div class="activity-copy">
                                    <div class="activity-title">@log.Action @log.EntityName</div>
                                    <div class="activity-detail">@(string.IsNullOrWhiteSpace(log.Summary) ? log.Details : log.Summary)</div>
                                    <div class="activity-time">@log.OccurredUtc.ToLocalTime().ToString("MMM d, HH:mm")</div>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>
    </div>

    <section class="dashboard-card">
        <div class="dashboard-card-head">
            <div>
                <h2 class="dashboard-card-title">POD coverage</h2>
                <p class="dashboard-card-subtitle">Recent points of distribution and their station owners</p>
            </div>
            <a class="btn btn-ghost btn-sm" asp-controller="@podController" asp-action="@podAction">
                View all PODs <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="dashboard-card-body is-flush">
            @if (Model.Pods.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-geo-alt"></i>
                    <div class="fw-semibold">No PODs to show yet</div>
                    <div class="text-hint small">Create a POD and assign it to a station and salesperson.</div>
                </div>
            }
            else
            {
                <div class="table-responsive dashboard-table">
                    <table class="table table-clean" id="podCoverageTable">
                        <thead>
                            <tr>
                                <th>POD</th>
                                <th>Station</th>
                                <th>Assigned to</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Pods)
                        {
                            <tr>
                                <td>
                                    <div class="employee-name">@row.Pod.Name</div>
                                    <div class="employee-sub">@(string.IsNullOrWhiteSpace(row.Pod.OSSPODID) ? "No OSS ID" : row.Pod.OSSPODID)</div>
                                </td>
                                <td>
                                    <div class="station-cell">
                                        <span class="station-icon"><i class="bi bi-building"></i></span>
                                        <span>@row.StationName</span>
                                    </div>
                                </td>
                                <td>
                                    @if (row.IsAssigned)
                                    {
                                        <div class="employee-cell">
                                            <span class="avatar-initials">@(row.SalesPersonName!.Trim()[..1].ToUpperInvariant())</span>
                                            <span class="employee-name">@row.SalesPersonName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="employee-cell">
                                            <span class="avatar-initials">?</span>
                                            <span class="text-muted">Unassigned</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (row.IsAssigned)
                                    {
                                        <span class="badge-soft badge-soft-success">Assigned</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft badge-soft-neutral">Unassigned</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="row-action" asp-controller="@podController" asp-action="@(Model.IsAdmin ? "DetailsPOD" : "MyPODs")" asp-route-id="@(Model.IsAdmin ? row.Pod.ID : (int?)null)" title="Open POD">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}
