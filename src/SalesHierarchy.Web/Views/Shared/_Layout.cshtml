@using Microsoft.AspNetCore.Identity
@using SalesHierarchy.Core.Interfaces.Repositories
@using SalesHierarchy.Web.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ISalesPersonRepository SalesPersonRepository
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Overview";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("SystemAdmin");
    var isSalesPerson = User.IsInRole("SalesPerson");

    var sectionLabel = controller switch
    {
        "Home" => "Overview",
        "Public" => "Public directory",
        "Admin" => isAdmin ? "Administration" : "Workspace",
        "SalesPerson" => "My workspace",
        "Account" => "Account",
        _ => "Workspace"
    };

    string NavClass(string controllerName, params string[] actions)
    {
        return controller == controllerName &&
               (actions.Length == 0 || Array.IndexOf(actions, action) >= 0)
            ? "active"
            : string.Empty;
    }

    var currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var userEmail = currentUser?.Email ?? User.Identity?.Name ?? string.Empty;
    var userInitials = string.IsNullOrWhiteSpace(userEmail)
        ? "U"
        : userEmail.Substring(0, 1).ToUpperInvariant();
    var userName = string.IsNullOrWhiteSpace(userEmail) ? "Signed in" : userEmail;
    var roleLabel = isAdmin ? "System admin" : isSalesPerson ? "Sales person" : "Member";

    var employeeCount = 0;
    if (isAuthenticated)
    {
        try
        {
            var allPeople = SalesPersonRepository.GetAll().ToList();
            if (isAdmin)
            {
                employeeCount = allPeople.Count;
            }
            else if (currentUser?.SalesPersonId is int salesPersonId)
            {
                var ids = new HashSet<int> { salesPersonId };
                var changed = true;
                while (changed)
                {
                    changed = false;
                    foreach (var person in allPeople)
                    {
                        if (person.ManagerId.HasValue && ids.Contains(person.ManagerId.Value) && ids.Add(person.ID))
                        {
                            changed = true;
                        }
                    }
                }

                employeeCount = ids.Count;
            }
        }
        catch
        {
            employeeCount = 0;
        }
    }

    var directoryController = isAdmin ? "Admin" : "SalesPerson";
    var directoryAction = isAdmin ? "SalesPersons" : "MyTeam";
    var hierarchyController = isAdmin ? "Admin" : "SalesPerson";
    var hierarchyAction = isAdmin ? "Hierarchy" : "ReportingHierarchy";
    var activityController = isAdmin ? "Admin" : "SalesPerson";
    var activityAction = isAdmin ? "AuditLog" : "TeamActivity";
    var searchUrl = isAdmin ? Url.Action("SalesPersons", "Admin") : Url.Action("MyTeam", "SalesPerson");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - SalesHierarchy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isAuthenticated ? "app-body" : "guest-body")">
@if (isAuthenticated)
{
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar" aria-label="Primary navigation">
            <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close navigation">
                <i class="bi bi-x-lg"></i>
            </button>

            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-diagram-3"></i></span>
                <span class="sidebar-brand-copy">
                    <span class="sidebar-brand-name d-block">SalesHierarchy</span>
                    <span class="sidebar-brand-sub d-block">Enterprise workspace</span>
                </span>
            </a>

            <div class="workspace-switcher dropdown">
                <button class="dropdown-toggle" type="button" id="workspaceMenu" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="workspace-avatar">SH</span>
                    <span>
                        <span class="d-block" style="font-size: 11px; color: #e2e8f0;">@(isAdmin ? "Head office" : "My workspace")</span>
                        <span class="d-block" style="font-size: 9px; color: #64748b;">@roleLabel</span>
                    </span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="workspaceMenu">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i>Overview</a></li>
                    <li><a class="dropdown-item" asp-controller="@directoryController" asp-action="@directoryAction"><i class="bi bi-people"></i>Employee directory</a></li>
                    <li><a class="dropdown-item" asp-controller="Public" asp-action="Index"><i class="bi bi-globe2"></i>Public directory</a></li>
                </ul>
            </div>

            <nav>
                <div class="nav-section">Workspace</div>
                <a class="nav-link @NavClass("Home", "Index", "Privacy")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Overview</span>
                </a>
                <a class="nav-link @(controller == directoryController && (action == directoryAction || action == "SalesPersons" || action == "MyTeam" || action == "DetailsSalesPerson" || action == "CreateSalesPerson" || action == "EditSalesPerson" || action == "CreateTeamMember" || action == "EditTeamMember") ? "active" : "")"
                   asp-controller="@directoryController" asp-action="@directoryAction">
                    <i class="bi bi-people"></i><span>Employee Directory</span>
                    @if (employeeCount > 0)
                    {
                        <span class="badge-count">@employeeCount</span>
                    }
                </a>
                <a class="nav-link @(controller == hierarchyController && action == hierarchyAction ? "active" : "")"
                   asp-controller="@hierarchyController" asp-action="@hierarchyAction">
                    <i class="bi bi-diagram-3"></i><span>Sales Hierarchy</span>
                </a>
                @if (isAdmin)
                {
                    <a class="nav-link @NavClass("Admin", "PODStations", "DetailsPODStation", "CreatePODStation", "EditPODStation", "DeletePODStation", "DeletePODStationConfirmed")" asp-controller="Admin" asp-action="PODStations">
                        <i class="bi bi-building"></i><span>POD Stations</span>
                    </a>
                    <a class="nav-link @NavClass("Admin", "PODs", "DetailsPOD", "CreatePOD", "EditPOD", "DeletePOD", "DeletePODConfirmed")" asp-controller="Admin" asp-action="PODs">
                        <i class="bi bi-geo-alt"></i><span>PODs</span>
                    </a>
                }
                else
                {
                    <a class="nav-link @NavClass("SalesPerson", "TeamPODs", "AssignTeamPOD")" asp-controller="SalesPerson" asp-action="TeamPODs">
                        <i class="bi bi-building"></i><span>POD Stations</span>
                    </a>
                    <a class="nav-link @NavClass("SalesPerson", "MyPODs")" asp-controller="SalesPerson" asp-action="MyPODs">
                        <i class="bi bi-geo-alt"></i><span>PODs</span>
                    </a>
                }
                <a class="nav-link @(controller == (isAdmin ? "Admin" : "SalesPerson") && action == (isAdmin ? "UserAccountManagement" : "MyProfile") ? "active" : "")"
                   asp-controller="@(isAdmin ? "Admin" : "SalesPerson")" asp-action="@(isAdmin ? "UserAccountManagement" : "MyProfile")">
                    <i class="bi bi-sliders"></i><span>Settings</span>
                </a>

                @if (isAdmin)
                {
                    <div class="nav-section">Administration</div>
                    <a class="nav-link @NavClass("Admin", "Dealers", "DetailsDealer", "CreateDealer", "EditDealer", "DeleteDealer", "DeleteDealerConfirmed")" asp-controller="Admin" asp-action="Dealers">
                        <i class="bi bi-shop"></i><span>Dealers</span>
                    </a>
                    <a class="nav-link @NavClass("Admin", "SalesDealerMappings", "DetailsSalesDealerMapping", "CreateSalesDealerMapping", "EditSalesDealerMapping", "DeleteSalesDealerMapping", "DeleteSalesDealerMappingConfirmed")" asp-controller="Admin" asp-action="SalesDealerMappings">
                        <i class="bi bi-diagram-2"></i><span>Mappings</span>
                    </a>
                    <a class="nav-link @NavClass("Admin", "BulkUpload", "BulkPreview", "ConfirmBulkUpload", "BulkResult", "DownloadErrorReport", "DownloadTemplate")" asp-controller="Admin" asp-action="BulkUpload">
                        <i class="bi bi-file-earmark-spreadsheet"></i><span>Bulk Upload</span>
                    </a>
                    <a class="nav-link @NavClass("Admin", "AuditLog")" asp-controller="Admin" asp-action="AuditLog">
                        <i class="bi bi-clock-history"></i><span>Activity Log</span>
                    </a>
                }
                else if (isSalesPerson)
                {
                    <div class="nav-section">My team</div>
                    <a class="nav-link @NavClass("SalesPerson", "MyProfile")" asp-controller="SalesPerson" asp-action="MyProfile">
                        <i class="bi bi-person"></i><span>My Profile</span>
                    </a>
                    <a class="nav-link @NavClass("SalesPerson", "MyDealers")" asp-controller="SalesPerson" asp-action="MyDealers">
                        <i class="bi bi-shop"></i><span>My Dealers</span>
                    </a>
                    <a class="nav-link @NavClass("SalesPerson", "TeamAccounts", "CreateTeamAccount", "ResendTeamInvitation", "DisableTeamAccount", "EnableTeamAccount", "DeleteTeamAccount")" asp-controller="SalesPerson" asp-action="TeamAccounts">
                        <i class="bi bi-shield-lock"></i><span>Team Accounts</span>
                    </a>
                    <a class="nav-link @NavClass("SalesPerson", "TeamPODs", "AssignTeamPOD")" asp-controller="SalesPerson" asp-action="TeamPODs">
                        <i class="bi bi-geo-alt"></i><span>Team PODs</span>
                    </a>
                    <a class="nav-link @NavClass("SalesPerson", "TeamDealerAssignments", "AddTeamMapping", "RemoveTeamMapping")" asp-controller="SalesPerson" asp-action="TeamDealerAssignments">
                        <i class="bi bi-diagram-2"></i><span>Team Mappings</span>
                    </a>
                    <a class="nav-link @NavClass("SalesPerson", "TeamActivity")" asp-controller="SalesPerson" asp-action="TeamActivity">
                        <i class="bi bi-clock-history"></i><span>Team Activity</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="system-status">
                    <span class="status-dot"></span>
                    <span>All systems operational</span>
                </div>
                <div class="sidebar-user">
                    <span class="avatar-initials">@userInitials</span>
                    <span class="sidebar-user-copy">
                        <span class="sidebar-user-name d-block">@userName</span>
                        <span class="sidebar-user-role d-block">@roleLabel</span>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-signout" title="Sign out" aria-label="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop" data-sidebar-close></div>

        <div class="app-main">
            <header class="app-header">
                <div class="app-header-left">
                    <button class="icon-button sidebar-toggle-mobile" type="button" data-sidebar-open aria-label="Open navigation" aria-controls="appSidebar" aria-expanded="false">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="app-header-copy">
                        <ul class="breadcrumb-trail">
                            <li>Workspace</li>
                            <li>@sectionLabel</li>
                            <li class="current">@pageTitle</li>
                        </ul>
                        <div class="app-header-title">@pageTitle</div>
                    </div>
                </div>

                <div class="topbar-spacer"></div>

                <button class="search-trigger" type="button" data-search-open aria-label="Search workspace">
                    <i class="bi bi-search"></i>
                    <span class="search-label">Search workspace</span>
                    <span class="kbd">Ctrl K</span>
                </button>

                <a class="icon-button" asp-controller="@activityController" asp-action="@activityAction" title="Activity" aria-label="Recent activity">
                    <i class="bi bi-bell"></i>
                    <span class="notification-dot"></span>
                </a>

                <partial name="_LoginPartial" />
            </header>

            <main class="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info border-0 shadow-sm">@TempData["Message"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="search-palette" id="searchPalette" aria-hidden="true" role="dialog" aria-label="Search workspace">
        <div class="search-palette-panel">
            <form method="get" action="@searchUrl">
                <div class="search-palette-head">
                    <i class="bi bi-search"></i>
                    <input type="search" name="q" placeholder="Search people, designations, PODs..." autocomplete="off" />
                    <button class="search-palette-close" type="button" data-search-close aria-label="Close search">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </form>
            <div class="search-palette-body">
                <div class="search-palette-label">Jump to</div>
                <a class="search-palette-link" asp-controller="@directoryController" asp-action="@directoryAction">
                    <i class="bi bi-people"></i>Employee directory
                    <span class="text-hint">@employeeCount</span>
                </a>
                <a class="search-palette-link" asp-controller="@hierarchyController" asp-action="@hierarchyAction">
                    <i class="bi bi-diagram-3"></i>Sales hierarchy
                    <span class="text-hint">Tree</span>
                </a>
                <a class="search-palette-link" asp-controller="Public" asp-action="Index">
                    <i class="bi bi-globe2"></i>Public directory
                    <span class="text-hint">Open</span>
                </a>
            </div>
            <div class="search-palette-foot">
                <span><kbd>Enter</kbd> search</span>
                <span><kbd>Esc</kbd> close</span>
                <span><kbd>Ctrl K</kbd> anytime</span>
            </div>
        </div>
    </div>
}
else
{
    <header class="guest-nav">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-diagram-3"></i></span>
                    <span class="fw-semibold">SalesHierarchy</span>
                </a>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <a class="btn btn-ghost btn-sm d-none d-sm-inline-flex" asp-controller="Public" asp-action="Index">
                        <i class="bi bi-globe2"></i>Public directory
                    </a>
                    <a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i>Sign in
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="container py-4 py-lg-5">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info border-0 shadow-sm">@TempData["Message"]</div>
            }
            @RenderBody()
        </div>
    </main>
    <footer class="guest-footer">
        <div class="container d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <span>&copy; @DateTime.Now.Year SalesHierarchy</span>
            <span>Approved public information only</span>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
