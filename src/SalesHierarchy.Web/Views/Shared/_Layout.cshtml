<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesHierarchy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-mark"><i class="bi bi-diagram-3"></i></div>
                <div>
                    <div class="fw-semibold">SalesHierarchy</div>
                    <div class="text-hint small">Enterprise Sales</div>
                </div>
            </a>
            <nav class="flex-grow-1 px-2">
                <div class="nav-section">Overview</div>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i> <span>Home</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Public" ? "active" : "")" asp-controller="Public" asp-action="Index">
                    <i class="bi bi-globe2"></i> <span>Public Directory</span>
                </a>
                @if (User.IsInRole("SystemAdmin"))
                {
                    <div class="nav-section">Administration</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i> <span>Admin Dashboard</span>
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="PODStations"><i class="bi bi-building"></i> <span>POD Stations</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="PODs"><i class="bi bi-geo-alt"></i> <span>PODs</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="SalesPersons"><i class="bi bi-people"></i> <span>Sales Persons</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Dealers"><i class="bi bi-shop"></i> <span>Dealers</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="SalesDealerMappings"><i class="bi bi-diagram-2"></i> <span>Mappings</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="CreateSalesPersonAccount"><i class="bi bi-person-plus"></i> <span>Create Account</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="BulkUpload"><i class="bi bi-file-earmark-spreadsheet"></i> <span>Bulk Upload</span></a>
                    <a class="nav-link" asp-controller="Admin" asp-action="UserAccountManagement"><i class="bi bi-shield-lock"></i> <span>User Accounts</span></a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "AuditLog" ? "active" : "")" asp-controller="Admin" asp-action="AuditLog"><i class="bi bi-clock-history"></i> <span>Activity Log</span></a>
                }
                @if (User.IsInRole("SalesPerson"))
                {
                    <div class="nav-section">My Workspace</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SalesPerson" ? "active" : "")" asp-controller="SalesPerson" asp-action="Dashboard">
                        <i class="bi bi-grid"></i> <span>Dashboard</span>
                    </a>
                    <a class="nav-link" asp-controller="SalesPerson" asp-action="MyProfile"><i class="bi bi-person"></i> <span>My Profile</span></a>
                    <a class="nav-link" asp-controller="SalesPerson" asp-action="MyPODs"><i class="bi bi-geo-alt"></i> <span>My PODs</span></a>
                    <a class="nav-link" asp-controller="SalesPerson" asp-action="MyDealers"><i class="bi bi-shop"></i> <span>My Dealers</span></a>
                    <a class="nav-link" asp-controller="SalesPerson" asp-action="MyTeam"><i class="bi bi-people"></i> <span>My Team</span></a>
                    <a class="nav-link" asp-controller="SalesPerson" asp-action="ReportingHierarchy"><i class="bi bi-diagram-3"></i> <span>Hierarchy</span></a>
                    <a class="nav-link" asp-controller="SalesPerson" asp-action="TeamDealerAssignments"><i class="bi bi-diagram-2"></i> <span>Team Mappings</span></a>
                }
            </nav>
        </aside>
        <div class="app-main">
            <header class="app-header">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-ghost d-lg-none" type="button" onclick="document.getElementById('appSidebar').classList.toggle('show')"><i class="bi bi-list"></i></button>
                    <div>
                        <div class="fw-semibold">@ViewData["Title"]</div>
                        <div class="text-hint small">SalesHierarchy Management</div>
                    </div>
                </div>
                <partial name="_LoginPartial" />
            </header>
            <main class="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info border-0 shadow-sm">@TempData["Message"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <header class="guest-nav sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-mark"><i class="bi bi-diagram-3"></i></div>
                    <span class="fw-semibold">SalesHierarchy</span>
                </a>
                <div class="ms-auto">
                    <a class="btn btn-brand" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="container py-4">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info border-0 shadow-sm">@TempData["Message"]</div>
            }
            @RenderBody()
        </div>
    </main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
