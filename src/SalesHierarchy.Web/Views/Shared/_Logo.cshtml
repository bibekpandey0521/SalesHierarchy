@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var logoFile = "dishhome-logo.svg";
}
@if (logoFile is not null)
{
    <img src="~/images/branding/@logoFile" alt="DishHome" class="brand-logo" />
}
else
{
    <span class="brand-mark" aria-hidden="true"><i class="bi bi-broadcast-pin"></i></span>
}