@using Microsoft.AspNetCore.Identity
@using SalesHierarchy.Web.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var email = user?.Email ?? User.Identity?.Name ?? string.Empty;
    var initials = string.IsNullOrWhiteSpace(email) ? "U" : email.Substring(0, 1).ToUpperInvariant();
    var roleLabel = User.IsInRole("SystemAdmin") ? "System admin" : User.IsInRole("SalesPerson") ? "Sales person" : "Member";

    <div class="topbar-user dropdown">
        <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
            <span class="avatar-initials">@initials</span>
            <span class="d-none d-lg-block text-start">
                <span class="topbar-user-name d-block">@email</span>
                <span class="topbar-user-role d-block">@roleLabel</span>
            </span>
            <i class="bi bi-chevron-down d-none d-lg-inline" style="font-size: 10px; color: #94a3b8;"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li class="px-2 py-2">
                <div class="fw-semibold" style="font-size: 12px;">@email</div>
                <div class="text-hint" style="font-size: 10px;">@roleLabel</div>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <a class="dropdown-item" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>Overview
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="@(User.IsInRole("SystemAdmin") ? "Admin" : "SalesPerson")" asp-action="@(User.IsInRole("SystemAdmin") ? "UserAccountManagement" : "MyProfile")">
                    <i class="bi bi-person"></i>Profile &amp; settings
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>Sign out
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
