@using Microsoft.AspNetCore.Identity
@using SalesHierarchy.Web.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var email = user?.Email ?? User.Identity?.Name ?? "";
    var initials = string.IsNullOrEmpty(email) ? "U" : email.Substring(0,1).ToUpper();
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
            <div class="avatar-initials">@initials</div>
            <div class="text-start d-none d-md-block">
                <div class="small fw-semibold">@email</div>
                <div class="text-hint small">
                    @if(User.IsInRole("SystemAdmin")){ <span>System Admin</span> }
                    else if(User.IsInRole("SalesPerson")){ <span>Sales Person</span> }
                </div>
            </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Home</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                </form>
            </li>
        </ul>
    </li>
}
</ul>
