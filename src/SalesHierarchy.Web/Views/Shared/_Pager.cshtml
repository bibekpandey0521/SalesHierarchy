@model SalesHierarchy.Web.ViewModels.PaginationViewModel

@if (Model.TotalItems > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top">
        <div class="text-hint small">
            Showing @Model.FirstItem&ndash;@Model.LastItem of @Model.TotalItems
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        @if (Model.HasPrevious)
                        {
                            <a class="page-link" asp-action="@Model.Action"
                               asp-all-route-data="Model.RouteValues"
                               asp-route-page="@(Model.Page - 1)">Previous</a>
                        }
                        else
                        {
                            <span class="page-link">Previous</span>
                        }
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 2)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="@Model.Action"
                                   asp-all-route-data="Model.RouteValues"
                                   asp-route-page="@p">@p</a>
                            </li>
                        }
                        else if (p == 2 || p == Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        @if (Model.HasNext)
                        {
                            <a class="page-link" asp-action="@Model.Action"
                               asp-all-route-data="Model.RouteValues"
                               asp-route-page="@(Model.Page + 1)">Next</a>
                        }
                        else
                        {
                            <span class="page-link">Next</span>
                        }
                    </li>
                </ul>
            </nav>
        }
    </div>
}
