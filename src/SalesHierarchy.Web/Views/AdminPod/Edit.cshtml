@model SalesHierarchy.Core.Models.Pod
@{
    ViewData["Title"] = "Edit Pod";
    var station = ViewBag.Station as SalesHierarchy.Core.Models.PodStation;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Edit Pod</h1>
        <p class="page-subtitle">Update Pod master data. Station and ownership are managed separately.</p>
    </div>
    <a asp-action="Index" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OSSPODID" class="form-label"></label>
                    <input asp-for="OSSPODID" type="number" min="1" step="1" class="form-control mono" autocomplete="off" />
                    <span asp-validation-for="OSSPODID" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Pod station</label>
                    <div class="form-control-plaintext">
                        @if (station != null)
                        {
                            <span>@station.Name</span>
                            <span class="text-hint mono small ms-2">@station.OSSPODStationId</span>
                        }
                        else
                        {
                            <span class="badge-soft badge-soft-warning">Unassigned</span>
                        }
                    </div>
                    <div class="form-text text-hint">
                        Change station assignments on the
                        <a asp-action="PodAssignments" asp-route-stationId="@Model.PODStationId">Pod Assignment Management</a>
                        page.
                    </div>
                </div>
            </div>
            <div class="alert alert-info border-0 mt-4">
                <i class="bi bi-info-circle me-1"></i>
                Salesperson ownership is managed with the salesperson's Pod assignments. The legacy single-owner value is synchronised automatically.
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">Save changes</button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
