@model SalesHierarchy.Core.Models.Pod
@{
    ViewData["Title"] = "New Pod";
}
<div class="page-head">
    <div>
        <h1 class="page-title">New Pod</h1>
        <p class="page-subtitle">Create master data. Station assignment is managed separately.</p>
    </div>
    <a asp-action="Index" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OSSPODID" class="form-label"></label>
                    <input asp-for="OSSPODID" type="number" min="1" step="1" class="form-control mono" autocomplete="off" />
                    <span asp-validation-for="OSSPODID" class="text-danger small"></span>
                </div>
            </div>
            <div class="alert alert-info border-0 mt-4 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                New Pods start without a station. Use
                <a asp-action="PodAssignments" class="alert-link">Pod Assignment Management</a>
                to assign one or more Pods to stations.
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-brand">Create Pod</button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
