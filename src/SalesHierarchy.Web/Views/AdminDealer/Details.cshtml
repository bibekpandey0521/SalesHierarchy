@model SalesHierarchy.Core.Models.Dealer
@using SalesHierarchy.Core.Models
@{
    ViewData["Title"] = "Dealer details";
    var people = ViewBag.People as Dictionary<int, SalesPerson> ?? new Dictionary<int, SalesPerson>();
    var mappings = ViewBag.Mappings as List<DealerMapping> ?? new List<DealerMapping>();
}
<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">Dealer details and mapped salespersons.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-ghost">Back</a>
        <a asp-action="Edit" asp-route-id="@Model.UniqueID" class="btn btn-brand"><i class="bi bi-pencil me-1"></i>Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-clean">
            <div class="card-header">Dealer information</div>
            <div class="card-body">
                <dl class="detail-list mb-0">
                    <dt>Name</dt>
                    <dd>@Model.Name</dd>
                    <dt>Code</dt>
                    <dd class="mono">@(string.IsNullOrWhiteSpace(Model.Code) ? "—" : Model.Code)</dd>
                    <dt>Database Id</dt>
                    <dd class="mono">@Model.UniqueID</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card-clean">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Mapped salespersons</span>
                <span class="badge-soft-neutral">@mappings.Count</span>
            </div>
            <div class="card-body p-0">
                @if (mappings.Count == 0)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-diagram-2"></i>
                        <div class="text-hint small">No salespersons are mapped to this dealer.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-clean mb-0">
                            <thead><tr><th>Salesperson</th><th>Designation</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var mapping in mappings)
                            {
                                <tr>
                                    <td class="fw-medium">
                                        @if (people.TryGetValue(mapping.SalesPersonId, out var person))
                                        {
                                            <a asp-action="Details" asp-controller="AdminSalesPerson" asp-route-id="@person.Id" class="link-subtle">@person.Name</a>
                                        }
                                        else
                                        {
                                            <span class="text-hint">Unknown</span>
                                        }
                                    </td>
                                    <td class="text-hint">@(people.TryGetValue(mapping.SalesPersonId, out var personDesignation) ? personDesignation.Designation : "—")</td>
                                    <td class="text-end"><a asp-action="Details" asp-controller="AdminDealerMapping" asp-route-id="@mapping.UniqueID" class="btn btn-sm btn-ghost">View mapping</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
