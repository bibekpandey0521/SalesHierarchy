@model SalesHierarchy.Core.Models.PodStation
@{
    ViewData["Title"] = "Edit Pod station";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Edit Pod station</h1>
        <p class="page-subtitle">Update the station name or external identifier.</p>
    </div>
    <a asp-action="Index" class="btn btn-ghost">Back to list</a>
</div>

<div class="card-clean form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autocomplete="off" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="OSSPODStationId" class="form-label"></label>
                <input asp-for="OSSPODStationId" type="number" min="1" step="1" class="form-control mono" autocomplete="off" />
                <span asp-validation-for="OSSPODStationId" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">Save changes</button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
