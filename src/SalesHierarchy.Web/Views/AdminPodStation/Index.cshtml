@model IEnumerable<SalesHierarchy.Core.Models.PodStation>
@{
    ViewData["Title"] = "Pod stations";
    var query = ViewBag.Query as string;
    var stationList = Model.ToList();
    var totalCount = ViewBag.TotalCount is int total ? total : stationList.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hierarchy.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1 class="page-title">Pod stations</h1>
        <p class="page-subtitle">Master data for Pod station locations and their unique OSS identifiers.</p>
    </div>
    <a asp-action="Create" class="btn btn-brand"><i class="bi bi-plus-lg"></i>New station</a>
</div>

<div class="toolbar-card">
    <form method="get" class="toolbar-search">
        <input type="search" name="q" value="@query" class="form-control form-control-sm" placeholder="Search stations or OSS IDs..." />
        <button type="submit" class="btn btn-ghost btn-sm" aria-label="Search stations"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <a asp-action="Index" class="btn btn-ghost btn-sm">Clear</a>
        }
    </form>
    <div class="toolbar-meta">
        <span>@totalCount station(s)</span>
    </div>
</div>

<div class="card-clean">
    <div class="card-body p-0">
        @if (stationList.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-building"></i>
                <div class="fw-semibold">No Pod stations yet</div>
                <div class="text-hint small">Create your first station to start assigning Pods.</div>
                <a asp-action="Create" class="btn btn-brand btn-sm mt-2">Create station</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-clean">
                    <thead>
                        <tr>
                            <th>Station</th>
                            <th>OSS Pod Station Id</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var station in stationList)
                    {
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <span class="station-icon"><i class="bi bi-building"></i></span>
                                    <span class="employee-name">@station.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="id-code text-muted">@station.OSSPODStationId</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@station.Id" class="btn btn-sm btn-ghost" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@station.Id" class="btn btn-sm btn-ghost" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@station.Id" class="btn btn-sm btn-ghost text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_Pager", (SalesHierarchy.Web.ViewModels.PaginationViewModel)ViewBag.Pager)
